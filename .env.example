# Copy to .env and fill in. .env is gitignored.

# Neon POOLED connection string (the "-pooler" host), with sslmode=require.
DATABASE_URL=

# openssl rand -base64 48
# Use a DIFFERENT value in each environment. Rotating this signs everyone out.
SESSION_SECRET=

# Absolute origin. Magic links are built from this and Origin is checked against it.
APP_URL=http://localhost:5173

# Transactional email. Leave RESEND_API_KEY blank locally to print sign-in
# links to the dev server terminal instead of sending them.
RESEND_API_KEY=
MAIL_FROM=Project Status <status@example.com>

# Read only by scripts/seed.mjs, never at runtime.
OWNER_EMAIL=
OWNER_NAME=

# Force terminal logging of sign-in links even when RESEND_API_KEY is set.
# Ignored unless VERCEL_ENV is undefined, so it cannot take effect on a deploy.
DEV_MAGIC_LINK_LOG=1

# Point the Neon HTTP driver at a local proxy instead of https://api.<host>/sql.
# Only needed to run against Postgres in Docker — see "Local development without
# Neon" in the README. Ignored unless VERCEL_ENV is undefined.
# NEON_FETCH_ENDPOINT=http://localhost:4444/sql
